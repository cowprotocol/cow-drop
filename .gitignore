node_modules/
dist/
.turbo/
*.tsbuildinfo

# foundry
contracts/out/
contracts/cache/
# Real broadcasts are kept: deployments/<chainId>.json records the addresses, but only the
# broadcast artifact records the tx hash, block and deployer that put them there — which is what
# you need to reconstruct a chain's deployment history without trusting an explorer.
# Simulations are not deployments, so dry-run/ stays ignored. Note the pattern needs `**` to reach
# foundry's actual nesting depth (broadcast/<script>/<chainId>/dry-run/).
contracts/broadcast/**/dry-run/

# keeper and watch tower state: registry, spend ledger, block cursors
/out/

