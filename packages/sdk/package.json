{
  "name": "@cowprotocol/cow-drop-sdk",
  "version": "0.1.0",
  "description": "Compute drop addresses and compile drop recipes",
  "license": "GPL-3.0-or-later",
  "author": "CoW Protocol",
  "homepage": "https://github.com/cowprotocol/cow-drop/tree/main/packages/sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cowprotocol/cow-drop.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/cowprotocol/cow-drop/issues"
  },
  "keywords": [
    "cow-protocol",
    "cow-shed",
    "cow-drop",
    "ethereum",
    "create2",
    "viem",
    "defi"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "API.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "generate": "node scripts/generate-constants.mjs"
  },
  "dependencies": {
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
